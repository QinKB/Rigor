{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/guard.py\"",
            "timeout": 5,
            "statusMessage": "Loading Codex Rigor state",
            "additionalContextLimit": 1800
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/guard.py\"",
            "timeout": 5,
            "statusMessage": "Saving Codex Rigor continuity"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/guard.py\"",
            "timeout": 5,
            "statusMessage": "Loading Codex Rigor assignment",
            "additionalContextLimit": 2400
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/guard.py\"",
            "timeout": 5,
            "statusMessage": "Checking Codex Rigor assignment result"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|Bash|apply_patch|Edit|Write|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/guard.py\"",
            "timeout": 8,
            "statusMessage": "Checking Codex Rigor gate"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent|Bash|apply_patch|Edit|Write|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/guard.py\"",
            "timeout": 8
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/guard.py\"",
            "timeout": 8,
            "statusMessage": "Checking Codex Rigor completion gates"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/guard.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
